    given-names: Marieke
    affiliation: >-
      Department of Energy and Construction Engineering,
      Dalarna University, Falun, Sweden

  - family-names: Bales
    given-names: Chris
    affiliation: >-
      Department of Energy and Construction Engineering and
      Sustainable Energy Research Centre,
      Dalarna University, Falun, Sweden

  - family-names: Battikh
    given-names: Michel
